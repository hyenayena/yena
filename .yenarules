# Rules for the assistant in this repository (format: /data/md/architecture/claude/rules-files.md). Only the user edits this file.
[deny read]
.yena/
.hyena/
.env*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
!*.pub
.netrc
.npmrc
secrets/
credentials.json

[deny write]
/yena
/install.sh
/compose.yaml
/Dockerfile
/seccomp.json
/scripts/
/modules/*/bin/
**/.git/hooks/

[ask write]
**/.git/config
/src/credentials.ts
/src/pm/run.ts
/src/pm/git-ssh.ts
/src/rules-provider.ts
/src/pm/module-data.ts
/src/pm/module-code.ts
