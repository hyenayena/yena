#!/bin/sh
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
cd -- "$dir"

usage() {
	on=''
	off=''
	if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
		on=$(printf '\033[36m')
		off=$(printf '\033[0m')
	fi
	printf 'Usage: ./yena [command] [args]  (no command runs yena)\n\n'
	while IFS='|' read -r name desc; do
		printf '  %s%-17s%s %s\n' "$on" "$name" "$off" "$desc"
	done <<'TABLE'
help|Show the list of commands
up|Start the container in the background
down|Stop and remove the container
restart|Restart the container
build|Build the image
rebuild|Recreate the container (no image build; run build first)
ps|Container status
logs|Container logs
kill|Stop every yena process in the container (app and background chats)
yena|Run the app (dev, via tsx; the default)
start|Run the compiled app from dist/
sh|Open a shell in the container
install|Install dependencies (npm install)
typecheck|Check types
test|Run the tests
typecheck-modules|Check types of every module
test-modules|Run the tests of every module
check|Run type checks and tests (host and modules)
compile|Compile TypeScript into dist/
claude|Run Claude Code in the container (arguments are passed through)
TABLE
}

ensure_up() {
	docker ps -q --filter 'name=^yena$' | grep -q . || docker compose up -d
}

run_exec() {
	tty=''
	[ -t 0 ] && tty=-t
	docker exec -e YENA_LOG_LEVEL -e YENA_LOG -i $tty yena "$@"
}

exec_in() {
	tty=''
	[ -t 0 ] && tty=-t
	exec docker exec -e YENA_LOG_LEVEL -e YENA_LOG -i $tty yena "$@"
}

# Docker does not stop a process in the container when its exec client goes away (a closed terminal
# window), so long interactive commands leave a mark with their pid inside the container, remove it
# when they end, and the script stops whatever is still marked when it exits or is hung up.
TRACK_RUN='mkdir -p /tmp/yena-exec && echo $$ > "$0" && "$@"; s=$?; rm -f "$0"; exit $s'
# The bracket keeps the pattern from matching the shell that runs it.
KILL_ALL='pat="[s]rc/cli\.ts|[r]unner/main\.ts"; n=$(pgrep -f -- "$pat" | wc -l); if [ "$n" -gt 0 ]; then pkill -TERM -f -- "$pat"; i=0; while [ "$i" -lt 30 ] && pgrep -f -- "$pat" >/dev/null; do sleep 0.1; i=$((i + 1)); done; pkill -KILL -f -- "$pat" 2>/dev/null; fi; rm -rf /tmp/yena-exec; echo "Stopped $n yena process(es)."'

TRACK_STOP='p=$(cat "$0" 2>/dev/null) || exit 0; rm -f "$0"; kill -HUP -"$p" 2>/dev/null || kill -HUP "$p" 2>/dev/null; exit 0'

stop_tracked() {
	docker exec yena sh -c "$TRACK_STOP" "$1" >/dev/null 2>&1 || true
}

# Text copied in the app (mouse selection) reaches the host clipboard even where the terminal ignores
# OSC 52: the app writes it as a file into .yena/.clipboard (/data/.clipboard in the container) and this
# script hands each file to the host's copy command and deletes it.
CLIP_DIR=.yena/.clipboard

clip_copier() {
	if [ "${YENA_CLIPBOARD:-}" = off ]; then
		return 0
	elif command -v pbcopy >/dev/null 2>&1; then
		echo pbcopy
	elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
		echo wl-copy
	elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
		echo 'xclip -selection clipboard'
	fi
}

watch_clipboard() {
	while :; do
		for f in "$CLIP_DIR"/*.txt; do
			[ -f "$f" ] || continue
			$1 < "$f" >/dev/null 2>&1 || true
			rm -f "$f"
		done
		sleep 0.3
	done
}

run_tracked() {
	tty=''
	[ -t 0 ] && tty=-t
	mark="/tmp/yena-exec/$$.$(date +%s)"
	clip_env=''
	clip_pid=''
	copier=''
	[ "${1-}" = --clipboard ] && shift && copier=$(clip_copier)
	if [ -n "$copier" ] && mkdir -p "$CLIP_DIR" 2>/dev/null && chmod 700 "$CLIP_DIR"; then
		rm -f "$CLIP_DIR"/*.txt
		watch_clipboard "$copier" &
		clip_pid=$!
		clip_env='-e YENA_CLIPBOARD_DIR=/data/.clipboard'
	fi
	trap 'stop_tracked "$mark"; [ -z "$clip_pid" ] || kill "$clip_pid" 2>/dev/null || true' EXIT
	trap 'exit 129' HUP
	trap 'exit 143' TERM
	status=0
	docker exec -e YENA_LOG_LEVEL -e YENA_LOG $clip_env -i $tty yena sh -c "$TRACK_RUN" "$mark" "$@" || status=$?
	exit "$status"
}

cmd=${1:-yena}
if [ $# -gt 0 ]; then
	shift
fi

case $cmd in
	help | -h | --help | up | down | restart | build | rebuild | ps | logs | kill | \
	yena | start | sh | install | typecheck | test | typecheck-modules | \
	test-modules | check | compile | claude) ;;
	*)
		printf 'Unknown command: %s\n' "$cmd" >&2
		printf '%s\n' 'Run ./yena help for the list of commands.' >&2
		exit 2
		;;
esac

if [ "$cmd" != claude ] && [ $# -gt 0 ]; then
	printf '%s takes no arguments\n' "$cmd" >&2
	exit 2
fi

case $cmd in
	help | -h | --help)
		usage
		exit 0
		;;
	claude)
		if [ ! -x modules/claude/bin/claude ]; then
			printf '%s\n' 'The claude module is not installed: mod install git@github.com:hyenayena/claude.git' >&2
			exit 1
		fi
		;;
esac

if ! command -v docker >/dev/null 2>&1; then
	printf '%s\n' 'docker not found. Run ./yena on the host; inside the container use npm run <script>.' >&2
	exit 1
fi

case $cmd in
	up) exec docker compose up -d ;;
	down) exec docker compose down ;;
	restart) exec docker compose restart ;;
	build) exec docker compose build ;;
	rebuild) exec docker compose up -d --force-recreate ;;
	kill)
		if ! docker ps -q --filter 'name=^yena$' | grep -q .; then
			printf '%s\n' 'The container is not running; nothing to stop.'
			exit 0
		fi
		exec docker exec yena sh -c "$KILL_ALL"
		;;
	ps) exec docker compose ps ;;
	logs) exec docker compose logs -f ;;
	yena) ensure_up; run_tracked --clipboard npm run dev ;;
	start) ensure_up; run_tracked --clipboard npm start ;;
	sh) ensure_up; run_tracked sh ;;
	install) ensure_up; exec_in npm install ;;
	typecheck) ensure_up; exec_in npm run typecheck ;;
	test) ensure_up; exec_in npm test ;;
	typecheck-modules) ensure_up; exec_in npm run typecheck:modules ;;
	test-modules) ensure_up; exec_in npm run test:modules ;;
	compile) ensure_up; exec_in npm run build ;;
	check)
		ensure_up
		for script in typecheck test typecheck:modules test:modules; do
			run_exec npm run "$script" || exit $?
		done
		;;
	claude) ensure_up; run_tracked modules/claude/bin/claude "$@" ;;
esac
